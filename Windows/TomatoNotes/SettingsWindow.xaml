<Window x:Class="TomatoNotes.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="番茄小记 · 设置" Width="590" Height="760" MinWidth="530" WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="25">
    <TextBlock Text="设置" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,15" />
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="专注与休息" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
      <UniformGrid Columns="4"><StackPanel Margin="0,0,5,10"><TextBlock Text="专注 / 分钟" Style="{StaticResource HintText}" /><TextBox Text="{Binding Data.Settings.FocusMinutes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Margin="0,0,5,10"><TextBlock Text="短休息 / 分钟" Style="{StaticResource HintText}" /><TextBox Text="{Binding Data.Settings.ShortBreakMinutes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Margin="0,0,5,10"><TextBlock Text="长休息 / 分钟" Style="{StaticResource HintText}" /><TextBox Text="{Binding Data.Settings.LongBreakMinutes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Margin="0,0,0,10"><TextBlock Text="每几轮长休息" Style="{StaticResource HintText}" /><TextBox Text="{Binding Data.Settings.LongBreakEvery, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></UniformGrid>
      <TextBlock Text="时长保存在本机，开始下一阶段时生效。正在进行的阶段不会被重置。" Style="{StaticResource HintText}" />
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="提醒与快捷键" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
      <CheckBox Content="系统托盘气泡通知" IsChecked="{Binding Data.Settings.NotificationsEnabled}" Margin="0,4" /><CheckBox Content="阶段结束提示音" IsChecked="{Binding Data.Settings.SoundEnabled}" Margin="0,4" /><CheckBox Content="记录专注期间前台 App 名称与时长" IsChecked="{Binding Data.Settings.RecordingEnabled}" Margin="0,4" />
      <TextBlock Text="快捷键使用 Ctrl + Alt。留空字母可停用；保存时会检测系统占用。" Style="{StaticResource HintText}" Margin="0,8,0,3" />
      <UniformGrid Columns="3"><StackPanel Margin="0,0,5,0"><TextBlock Text="开始 / 暂停" Style="{StaticResource HintText}" /><TextBox Text="{Binding Data.Settings.TimerHotkey.Letter, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" /></StackPanel><StackPanel Margin="0,0,5,0"><TextBlock Text="快速待办" Style="{StaticResource HintText}" /><TextBox Text="{Binding Data.Settings.TodoHotkey.Letter, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" /></StackPanel><StackPanel><TextBlock Text="最近便签" Style="{StaticResource HintText}" /><TextBox Text="{Binding Data.Settings.NoteHotkey.Letter, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" /></StackPanel></UniformGrid>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="外观" Style="{StaticResource TitleText}" Margin="0,0,0,10" /><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Data.Settings.Appearance}"><ComboBoxItem Content="跟随 Windows 系统" Tag="system" /><ComboBoxItem Content="浅色" Tag="light" /><ComboBoxItem Content="深色" Tag="dark" /></ComboBox><TextBlock Text="外观在保存后应用到 Windows 各窗口。" Style="{StaticResource HintText}" Margin="0,6,0,0" />
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="连接 AI 服务商" Style="{StaticResource TitleText}" Margin="0,0,0,10" />
      <ComboBox x:Name="ProviderBox" SelectionChanged="Provider_Changed" DisplayMemberPath="Name" SelectedValuePath="ID" SelectedValue="{Binding Data.Settings.AI.ProviderID}" />
      <TextBlock Text="自定义接口基础地址（通常以 /v1 结尾）" Style="{StaticResource HintText}" Margin="0,9,0,3" /><TextBox Text="{Binding Data.Settings.AI.CustomBaseURL, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Text="API Key（留空则保留已保存密钥）" Style="{StaticResource HintText}" Margin="0,9,0,3" /><PasswordBox x:Name="APIKeyBox" Padding="9,7" />
      <StackPanel Orientation="Horizontal" Margin="0,9"><Button Content="保存 API Key" Click="SaveKey_Click" /><Button Content="移除本机密钥" Click="RemoveKey_Click" Margin="7,0,0,0" /></StackPanel>
      <UniformGrid Columns="2" Margin="0,8"><Button Content="获取可用模型" Click="FetchModels_Click" Margin="0,0,4,0" /><Button Content="测试连接" Click="TestAI_Click" Margin="4,0,0,0" /></UniformGrid>
      <TextBlock Text="使用模型" Style="{StaticResource HintText}" Margin="0,9,0,3" /><ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding Data.Settings.AI.ModelOverride}" SelectionChanged="Model_Changed" />
      <TextBlock Text="{Binding AIStatus}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="自动回顾" Style="{StaticResource TitleText}" Margin="0,0,0,10" /><CheckBox IsChecked="{Binding Data.Settings.Review.AutoSummarizeSessions}" Margin="0,5"><TextBlock Text="每轮专注结束后自动整理成果（投入至少 1 分钟）" /></CheckBox><CheckBox Content="每天定时生成回顾" IsChecked="{Binding Data.Settings.Review.ScheduleEnabled}" Margin="0,5" />
      <DockPanel><TextBlock Text="每天" /><TextBox Text="{Binding Data.Settings.Review.Hour, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="8,0" /><TextBlock Text=":" /><TextBox Text="{Binding Data.Settings.Review.Minute, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="8,0" /><TextBlock Text="（24 小时制；退出与锁屏期间不执行）" Style="{StaticResource HintText}" /></DockPanel>
    </StackPanel></Border>
    <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="Save_Click" Padding="12,10" />
    <TextBlock Text="Windows 版不包含 Liquid Glass、合盖策略与 AppleScript Chrome 守护；这些 macOS 字段会保留。" Style="{StaticResource HintText}" TextAlignment="Center" Margin="0,14,0,0" />
  </StackPanel></ScrollViewer>
</Window>
