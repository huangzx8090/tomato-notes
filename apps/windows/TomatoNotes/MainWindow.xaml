<Window x:Class="TomatoNotes.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:local="clr-namespace:TomatoNotes.Windows" Title="番茄小记" Width="470" Height="760" MinWidth="430" MinHeight="620" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
  <Window.Resources>
    <local:StrikeConverter x:Key="Strike" />
    <local:MinutesConverter x:Key="Minutes" />
    <local:DurationConverter x:Key="Duration" />
  </Window.Resources>
  <DockPanel Margin="22,16">
    <StackPanel DockPanel.Dock="Bottom">
      <Border x:Name="DeletedBar" Background="#EEE4D6" CornerRadius="8" Padding="10" Margin="0,8,0,0" Visibility="Collapsed"><DockPanel><Button DockPanel.Dock="Right" Content="撤销" Style="{StaticResource LinkButton}" Click="UndoTodo_Click" /><TextBlock x:Name="DeletedText" FontSize="11" /></DockPanel></Border>
      <TextBlock Text="{Binding Feedback}" Style="{StaticResource HintText}" Foreground="{StaticResource Accent}" Margin="0,8,0,0" />
      <TextBlock Text="{Binding StorageLabel}" Style="{StaticResource HintText}" TextAlignment="Center" Margin="0,6,0,0" />
    </StackPanel>
    <StackPanel>
      <DockPanel Margin="0,0,0,15">
        <Border Width="36" Height="36" CornerRadius="10" Background="#EBDDCF" DockPanel.Dock="Left"><TextBlock Text="🍅" HorizontalAlignment="Center" FontSize="19" /></Border>
        <StackPanel Margin="10,0,0,0"><TextBlock Text="番茄小记" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="把时间留给在意的事" Style="{StaticResource HintText}" /></StackPanel>
        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat=MM-dd}" Style="{StaticResource HintText}" />
      </DockPanel>
      <TextBlock x:Name="LoadError" Style="{StaticResource HintText}" Foreground="{StaticResource Accent}" Margin="0,0,0,10" />
      <UniformGrid Columns="5" Margin="0,0,0,15">
        <Button Content="专注" Click="Tab_Click" Tag="0" /><Button Content="待办" Click="Tab_Click" Tag="1" /><Button Content="今日" Click="Tab_Click" Tag="2" /><Button Content="便签" Click="Tab_Click" Tag="3" /><Button Content="设置" Click="Tab_Click" Tag="4" />
      </UniformGrid>
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="570">
        <Grid>
          <StackPanel Visibility="{Binding IsFocusTab, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" Foreground="{StaticResource Secondary}" FontSize="12" />
            <TextBlock Text="{Binding Remaining}" HorizontalAlignment="Center" FontSize="66" FontFamily="Consolas" Margin="0,5" />
            <TextBlock Text="{Binding TimerCaption}" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource HintText}" FontSize="12" Margin="0,0,0,12" />
            <TextBox Text="{Binding Goal, UpdateSourceTrigger=PropertyChanged}" Tag="本轮目标（可选）" ToolTip="本轮目标（计划不代表完成）" MaxLength="300" Margin="35,0,35,12"><TextBox.Resources><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}" /></TextBox.Resources></TextBox>
            <Button Content="{Binding PrimaryAction}" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" FontSize="15" Margin="70,5,70,5" Padding="12,11" />
            <Button Content="{Binding EndEarlyLabel}" Command="{Binding EndCommand}" Visibility="{Binding CanEndEarly, Converter={StaticResource BoolVisibility}}" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" />
            <Button Content="跳过这次休息" Command="{Binding EndCommand}" Visibility="{Binding CanSkipBreak, Converter={StaticResource BoolVisibility}}" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" />
            <UniformGrid Columns="2" Margin="0,20,0,10">
              <Border Style="{StaticResource Card}" Margin="0,0,5,0"><StackPanel><TextBlock Text="{Binding TodayMinutes}" FontSize="26" HorizontalAlignment="Center" /><TextBlock Text="今日专注 / 分钟" HorizontalAlignment="Center" Style="{StaticResource HintText}" /></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="5,0,0,0"><StackPanel><TextBlock Text="{Binding TodayCompleted}" FontSize="26" HorizontalAlignment="Center" /><TextBlock Text="完整番茄 / 轮" HorizontalAlignment="Center" Style="{StaticResource HintText}" /></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Windows 专注守护暂未提供" Style="{StaticResource TitleText}" FontSize="13" /><TextBlock Text="macOS 的 AppleScript、窗口截图及自动关闭 Chrome 标签依赖专属接口，本版不展示不可用的守护开关。前台 App 投入统计仍可使用。" Style="{StaticResource HintText}" Margin="0,8,0,0" /></StackPanel></Border>
          </StackPanel>
          <StackPanel Visibility="{Binding IsTodoTab, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="今天想做什么？" Style="{StaticResource TitleText}" Margin="0,0,0,10" />
            <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="添加" Command="{Binding AddTodoCommand}" Margin="7,0,0,0" Style="{StaticResource PrimaryButton}" /><TextBox Text="{Binding NewTodo, UpdateSourceTrigger=PropertyChanged}" KeyDown="NewTodo_KeyDown" /></DockPanel>
            <ItemsControl ItemsSource="{Binding TodayTodos}"><ItemsControl.ItemTemplate><DataTemplate>
              <Border Style="{StaticResource Card}" Padding="11"><DockPanel><CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsCompleted, Mode=OneWay}" Click="TodoToggle_Click" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="改字" Click="TodoEdit_Click" Padding="6,3" /><Button Content="删除" Click="TodoDelete_Click" Padding="6,3" /></StackPanel>
                <TextBlock Text="{Binding Text}" TextDecorations="{Binding IsCompleted, Converter={StaticResource Strike}}" Margin="8,0" />
              </DockPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="回车添加，勾选完成。删除后可以在本页底部撤销。" Style="{StaticResource HintText}" />
          </StackPanel>
          <StackPanel Visibility="{Binding IsTodayTab, Converter={StaticResource BoolVisibility}}">
            <DockPanel Margin="0,0,0,12"><Button Content="‹" Click="PreviousDay_Click" /><TextBlock Text="{Binding SelectedDay}" HorizontalAlignment="Center" /><Button Content="›" Click="NextDay_Click" /></DockPanel>
            <Button Content="回到今天" Click="Today_Click" Style="{StaticResource LinkButton}" Visibility="{Binding IsHistoryDay, Converter={StaticResource BoolVisibility}}" />
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="这一天留下的进展" Style="{StaticResource TitleText}" /><TextBlock FontSize="36" Margin="0,10"><Run Text="{Binding Summary.FocusSeconds, Converter={StaticResource Minutes}}" /><Run Text=" 分钟专注" FontSize="13" /></TextBlock><TextBlock Style="{StaticResource HintText}"><Run Text="完整 " /><Run Text="{Binding Summary.CompletedSessions}" /><Run Text=" 轮 · 完成待办 " /><Run Text="{Binding Summary.CompletedTodos}" /><Run Text=" / " /><Run Text="{Binding Summary.Todos.Count}" /></TextBlock><Button Content="补充记录并生成每日 AI 回顾" Click="DayReview_Click" Margin="0,12,0,0" /></StackPanel></Border>
            <ItemsControl ItemsSource="{Binding Summary.Sessions}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="{Binding Goal, TargetNullValue=本轮专注, FallbackValue=本轮专注}" FontWeight="SemiBold" /><TextBlock Text="{Binding StartedAt, StringFormat=HH:mm}" Style="{StaticResource HintText}" /><Button Content="查看本轮与补充成果" Click="SessionReview_Click" HorizontalAlignment="Left" Margin="0,8,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="专注时使用的 App" Style="{StaticResource TitleText}" FontSize="14" /><TextBlock Text="仅记录前台停留时长；App 名称不等于具体成果。" Style="{StaticResource HintText}" Margin="0,3,0,8" /><ItemsControl ItemsSource="{Binding Summary.Apps}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,5"><TextBlock DockPanel.Dock="Right" Text="{Binding Seconds, Converter={StaticResource Duration}}" Style="{StaticResource HintText}" /><TextBlock Text="{Binding Name}" /></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          </StackPanel>
          <StackPanel Visibility="{Binding IsNotesTab, Converter={StaticResource BoolVisibility}}">
            <DockPanel Margin="0,0,0,12"><TextBlock Text="今天的便签" Style="{StaticResource TitleText}" /><Button DockPanel.Dock="Right" Content="＋ 新建便签" Click="CreateNote_Click" Style="{StaticResource PrimaryButton}" /></DockPanel>
            <ItemsControl ItemsSource="{Binding VisibleNotes}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="12"><DockPanel><Button DockPanel.Dock="Right" Content="打开" Click="OpenNote_Click" /><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding UpdatedAt, StringFormat=HH:mm 更新}" Style="{StaticResource HintText}" /></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="历史便签" Style="{StaticResource TitleText}" Margin="0,10,0,8" />
            <ItemsControl ItemsSource="{Binding HistoryNotes}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="12"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="继续" Click="ContinueNote_Click" Padding="7,4" /><Button Content="删除" Click="DeleteNote_Click" Padding="7,4" /></StackPanel><TextBlock Text="{Binding Title}" /><TextBlock Text="{Binding DayKey}" Style="{StaticResource HintText}" /></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
          <StackPanel Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="设置" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="专注与休息" FontWeight="SemiBold" /><TextBlock Text="时长、快捷键、外观、提醒和自动回顾在完整设置中调整。" Style="{StaticResource HintText}" Margin="0,5" /><Button Content="打开完整设置" Click="Settings_Click" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AI 助手" FontWeight="SemiBold" /><TextBlock Text="支持 DeepSeek、OpenAI 及 OpenAI 兼容服务商。API Key 使用 Windows DPAPI 按当前用户加密，不写入 JSON。" Style="{StaticResource HintText}" Margin="0,5" /><TextBlock Text="{Binding AIStatus}" Style="{StaticResource HintText}" /><Button Content="配置 AI 与自动回顾" Click="Settings_Click" Margin="0,6,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="数据与隐私" FontWeight="SemiBold" /><TextBlock Text="资料保存在 %APPDATA%\TomatoNotes，与 macOS 的 v4 JSON 格式兼容。移动资料前请先备份 JSON 和关联图片。" Style="{StaticResource HintText}" Margin="0,5" /><UniformGrid Columns="2"><Button Content="备份数据" Command="{Binding BackupCommand}" Margin="0,0,5,0" /><Button Content="打开资料位置" Click="DataFolder_Click" Margin="5,0,0,0" /></UniformGrid></StackPanel></Border>
            <TextBlock Text="Windows 10（1809）及 Windows 11 · x64&#x0a;系统托盘气泡通知 · Ctrl+Alt+P / T / N&#x0a;不包含 macOS 玻璃效果、合盖策略和 Chrome 自动关闭。" Style="{StaticResource HintText}" TextAlignment="Center" Margin="0,10" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </StackPanel>
  </DockPanel>
</Window>
