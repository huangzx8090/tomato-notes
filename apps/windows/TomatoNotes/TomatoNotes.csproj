<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TomatoNotes</AssemblyName>
    <RootNamespace>TomatoNotes.Windows</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <VersionPrefix>1.6.3</VersionPrefix>
    <AssemblyVersion>1.6.3.0</AssemblyVersion>
    <FileVersion>1.6.3.0</FileVersion>
    <Product>番茄小记</Product>
    <Description>把时间留给在意的事</Description>
    <Company>TomatoNotes</Company>
    <Copyright>Copyright © TomatoNotes contributors</Copyright>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TomatoNotes.Core/TomatoNotes.Core.csproj" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- 标题栏品牌图标，由 macOS Packaging/BrandMark.png 缩到 128²，避免把 1 MB 原图打进安装包 -->
    <Resource Include="Assets\BrandMark.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
</Project>
