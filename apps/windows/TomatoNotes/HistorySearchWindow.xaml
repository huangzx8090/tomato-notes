<ui:FluentWindow x:Class="TomatoNotes.Windows.HistorySearchWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="历史搜索" Width="560" Height="680" MinWidth="420" MinHeight="480"
                 WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UIFont}"
                 Foreground="{DynamicResource Ink}" ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None" WindowCornerPreference="Round">
  <DockPanel Background="{DynamicResource Background}">
    <ui:TitleBar DockPanel.Dock="Top" Title="历史搜索" ShowMaximize="False" Height="36" />
    <Border DockPanel.Dock="Top" Style="{StaticResource PaperCard}" Margin="22,0,22,12">
      <StackPanel>
        <Grid>
          <TextBox x:Name="Query" Style="{StaticResource BrandTextBox}"
                   KeyDown="Query_KeyDown" TextChanged="Query_TextChanged" />
          <TextBlock x:Name="QueryPlaceholder" Text="搜索待办、便签、专注目标或成果" Style="{StaticResource HintText}"
                     Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <CheckBox x:Name="FilterTodo" Content="待办" IsChecked="True" Checked="Filters_Changed" Unchecked="Filters_Changed"
                    FontSize="11" Foreground="{DynamicResource Ink}" Margin="0,0,12,0" />
          <CheckBox x:Name="FilterNote" Content="便签" IsChecked="True" Checked="Filters_Changed" Unchecked="Filters_Changed"
                    FontSize="11" Foreground="{DynamicResource Ink}" Margin="0,0,12,0" />
          <CheckBox x:Name="FilterFocus" Content="专注" IsChecked="True" Checked="Filters_Changed" Unchecked="Filters_Changed"
                    FontSize="11" Foreground="{DynamicResource Ink}" Margin="0,0,12,0" />
          <CheckBox x:Name="FilterOutcome" Content="成果" IsChecked="True" Checked="Filters_Changed" Unchecked="Filters_Changed"
                    FontSize="11" Foreground="{DynamicResource Ink}" />
        </StackPanel>
        <DockPanel Margin="0,10,0,0">
          <TextBlock DockPanel.Dock="Left" Text="从" FontSize="11" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" Margin="0,0,7,0" />
          <DatePicker x:Name="ThroughDay" FontSize="11" DockPanel.Dock="Right" SelectedDateChanged="DateFilter_Changed" />
          <TextBlock DockPanel.Dock="Right" Text="到" FontSize="11" Foreground="{DynamicResource Secondary}"
                     VerticalAlignment="Center" Margin="0,0,7,0" />
          <DatePicker x:Name="FromDay" FontSize="11" SelectedDateChanged="DateFilter_Changed" />
        </DockPanel>
      </StackPanel>
    </Border>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Style="{StaticResource CaptionText}"
               Margin="22,0,22,12" />
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="Results" Margin="22,0,22,12">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Button Style="{StaticResource SubtleButton}" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                       Click="Result_Click" Tag="{Binding}" AutomationProperties.Name="{Binding Title}">
              <StackPanel>
                <DockPanel Margin="0,0,0,4">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Day}" Style="{StaticResource CaptionText}"
                             Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Text="{Binding Excerpt}" Style="{StaticResource HintText}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource CaptionText}"
                           Visibility="{Binding SourceLabel, Converter={StaticResource NotEmptyVisibility}}" />
              </StackPanel>
            </ui:Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</ui:FluentWindow>
