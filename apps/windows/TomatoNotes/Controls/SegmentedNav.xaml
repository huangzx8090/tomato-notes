<UserControl x:Class="TomatoNotes.Windows.Controls.SegmentedNav"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="44" Focusable="False">
  <UserControl.Resources>
    <Style x:Key="NavTab" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Trigger>
        <!-- 放在 IsMouseOver 之后：选中态优先，悬停不会盖掉强调色 -->
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Accent}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid x:Name="Root">
    <Border CornerRadius="22" Background="{DynamicResource NavTrack}" />
    <Canvas x:Name="IndicatorLayer" Margin="4">
      <Border x:Name="Indicator" Height="36" CornerRadius="18" Background="{DynamicResource Surface}" Width="0"
              Canvas.Left="0" Visibility="Hidden">
        <Border.Effect>
          <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.14" Color="#302E2B" />
        </Border.Effect>
      </Border>
    </Canvas>
    <UniformGrid x:Name="Tabs" Columns="5" Margin="4" />
  </Grid>
</UserControl>
